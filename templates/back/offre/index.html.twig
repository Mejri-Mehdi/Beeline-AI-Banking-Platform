    <script>
        // Filtrage des offres par statut
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                
                const filter = this.dataset.filter;
                const rows = document.querySelectorAll('.offre-row');
                
                rows.forEach(row => {
                    if (filter === 'all' || row.dataset.status === filter) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });
        });
        
        // Recherche
        document.getElementById('searchInput').addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase();
            const rows = document.querySelectorAll('.offre-row');
            
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(searchTerm) ? '' : 'none';
            });
        });
        
        // Filtrage par banque
        function appliquerFiltreBanque() {
            const banqueFilter = document.getElementById('banqueFilter').value;
            const rows = document.querySelectorAll('.offre-row');
            
            rows.forEach(row => {
                if (banqueFilter === 'all') {
                    row.style.display = '';
                } else {
                    if (row.dataset.banque === banqueFilter) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                }
            });
            
            // Fermer le dropdown
            const dropdown = document.querySelector('.dropdown .btn');
            bootstrap.Dropdown.getInstance(dropdown).hide();
        }
        
        // Fonction pour supprimer une offre
        function deleteOffre(id, nom) {
            if (confirm(`Êtes-vous sûr de vouloir supprimer l'offre "${nom}" (ID: #OFF-${id.toString().padStart(3, '0')})?`)) {
                alert(`Offre "${nom}" supprimée (simulation)`);
                // En production : requête AJAX pour suppression
            }
        }
    </script>
    
